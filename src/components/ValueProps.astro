---
import { Icon } from 'astro-icon/components';

const items = [
	{ icon: 'tabler:home-2', title: 'Find Your Dream Home' },
	{ icon: 'tabler:wallet', title: 'Unlock Property Value' },
	{ icon: 'tabler:buildings', title: 'Effortless Property Management' },
	{ icon: 'tabler:bulb', title: 'Smart Investments, Informed Decisions' },
];
---

<section class="value-props">
	<div class="container">
		<div class="value-props__strip">
			{
				items.map((item) => (
					<a href="#" class="value-card">
						<span class="value-card__arrow">
							<Icon name="tabler:arrow-up-right" width="16" height="16" />
						</span>
						<span class="value-card__icon-ring">
							<span class="value-card__icon">
								<Icon name={item.icon} width="20" height="20" />
							</span>
						</span>
						<span class="value-card__title">{item.title}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.value-props__strip {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.625rem;
		padding: 0.625rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: 0 0 0 6px #191919;
	}
	.value-card {
		position: relative;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border);
		border-radius: 0.625rem;
		padding: 1.875rem 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
		transition: border-color 0.2s ease;
	}
	.value-card:hover {
		border-color: var(--color-purple-60);
	}
	.value-card__icon-ring {
		width: 3.75rem;
		height: 3.75rem;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.value-card__icon {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-purple-75);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.value-card__arrow {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		color: var(--color-grey-30);
	}
	.value-card__title {
		font-weight: var(--font-weight-semibold);
		font-size: 1rem;
	}
</style>
