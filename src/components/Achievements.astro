---
import { Icon } from 'astro-icon/components';

const items = [
	{
		icon: 'tabler:award',
		title: '3+ Years of Excellence',
		desc: "With over 3 years in the industry, we've amassed a wealth of knowledge and experience.",
	},
	{
		icon: 'tabler:users-group',
		title: 'Happy Clients',
		desc: "Our greatest achievement is the satisfaction of our clients. Their success stories fuel our passion for what we do.",
	},
	{
		icon: 'tabler:trophy',
		title: 'Industry Recognition',
		desc: "We've earned the respect of our peers and industry leaders, with accolades and awards that reflect our commitment to excellence.",
	},
];
---

<section class="section" id="achievements">
	<div class="container">
		<div class="section__head">
			<div>
				<p class="eyebrow" aria-hidden="true">
					<Icon name="heroicons:sparkles" width="16" height="16" />
					<Icon name="heroicons:sparkles" width="10" height="10" />
					<span class="eyebrow__dot"></span>
				</p>
				<h2 class="section__title">Our Achievements</h2>
				<p class="section__desc">
					Our story is one of continuous growth and evolution. We started as a small team with
					big dreams, determined to create a real estate platform that transcended the ordinary.
				</p>
			</div>
		</div>

		<div class="achievements-grid">
			{
				items.map((item) => (
					<article class="achievement-card">
						<span class="achievement-card__icon">
							<Icon name={item.icon} width="22" height="22" />
						</span>
						<h3>{item.title}</h3>
						<p>{item.desc}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.achievements-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}
	.achievement-card {
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		padding: 1.75rem;
	}
	.achievement-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-purple-75);
		margin-bottom: 1.25rem;
	}
	.achievement-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}
	.achievement-card p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.achievements-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
