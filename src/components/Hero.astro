---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import heroBuilding from '../assets/home-page/Image (3).png';
---

<section class="hero">
	<div class="hero__inner">
		<div class="hero__content">
			<h1>Discover Your Dream Property with Estatein</h1>
			<p>
				Your journey to finding the perfect property begins here. Explore our listings to find the
				home that matches your dreams.
			</p>
			<div class="hero__actions">
				<a href="#about" class="btn btn--outline">Learn More</a>
				<a href="#properties" class="btn btn--solid">Browse Properties</a>
			</div>
			<div class="hero__stats">
				<div class="stat">
					<span class="stat__value">200+</span>
					<span class="stat__label">Happy Customers</span>
				</div>
				<div class="stat">
					<span class="stat__value">10k+</span>
					<span class="stat__label">Properties For Clients</span>
				</div>
				<div class="stat">
					<span class="stat__value">16+</span>
					<span class="stat__label">Years of Experience</span>
				</div>
			</div>
		</div>

		<div class="hero__visual">
			<Image
				src={heroBuilding}
				alt="Modern high-rise building"
				widths={[460, 690, 1000]}
				sizes="(max-width: 900px) 100vw, 690px"
				class="hero__visual-img"
			/>
		</div>

		<div class="hero__badge" aria-hidden="true">
			<div class="hero__badge-ring-wrap">
				<svg class="hero__badge-ring" viewBox="0 0 100 100">
					<defs>
						<path
							id="badge-circle"
							d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"
							fill="none"></path>
					</defs>
					<text>
						<textPath href="#badge-circle" startOffset="0">
							DISCOVER YOUR DREAM PROPERTY • DISCOVER YOUR DREAM PROPERTY •
						</textPath>
					</text>
				</svg>
			</div>
			<span class="hero__badge-arrow">
				<Icon name="heroicons:arrow-up-right" width="24" height="24" />
			</span>
		</div>
	</div>
</section>

<style>
	.hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: stretch;
		gap: clamp(1.5rem, 4vw, 3.75rem);
		min-height: 622px;
	}
	.hero__content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 3.125rem;
		padding: 3rem 0 3rem clamp(1.5rem, 5vw, 5rem);
	}
	.hero__content h1 {
		font-size: clamp(2rem, 3.5vw, 2.875rem);
		font-weight: var(--font-weight-semibold);
		line-height: 1.2;
		margin: 0 0 1.25rem;
	}
	.hero__content p {
		color: var(--color-text-muted);
		font-weight: var(--font-weight-medium);
		max-width: 460px;
		line-height: 1.5;
		margin: 0;
	}
	.hero__actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.hero__stats {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.stat {
		border: 1px solid var(--color-border);
		border-radius: 0.625rem;
		padding: 0.875rem 1.25rem;
		background: var(--color-surface-raised);
		min-width: 140px;
	}
	.stat__value {
		display: block;
		font-size: 1.875rem;
		font-weight: var(--font-weight-bold);
	}
	.stat__label {
		display: block;
		color: var(--color-text-muted);
		font-weight: var(--font-weight-medium);
		font-size: 0.875rem;
		margin-top: 0.15rem;
	}

	.hero__visual {
		position: relative;
		overflow: hidden;
		background: var(--color-surface-raised);
	}
	.hero__visual::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(238deg, rgba(42, 33, 63, 0.9) 9%, rgba(25, 25, 25, 0) 50%);
	}
	.hero__visual :global(.hero__visual-img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center bottom;
	}

	.hero__badge {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 129px;
		height: 129px;
		z-index: 1;
	}
	.hero__badge-ring-wrap {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.hero__badge-ring {
		width: 106px;
		height: 106px;
		animation: spin 18s linear infinite;
	}
	.hero__badge-ring text {
		fill: var(--color-white);
		font-size: 6.5px;
		font-weight: var(--font-weight-semibold);
		letter-spacing: 2px;
		text-transform: uppercase;
		font-family: var(--font-primary);
	}
	.hero__badge-arrow {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 59px;
		height: 59px;
		border-radius: 50%;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-white);
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (max-width: 900px) {
		.hero__inner {
			grid-template-columns: 1fr;
			min-height: 0;
		}
		.hero__content {
			padding: 2.5rem 1.5rem 2rem;
			gap: 2rem;
		}
		.hero__visual {
			height: 280px;
		}
		.hero__badge {
			display: none;
		}
	}
</style>
