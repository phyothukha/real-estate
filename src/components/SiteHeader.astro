---
import { Icon } from 'astro-icon/components';
import EstateinLogo from './EstateinLogo.astro';

const navItems = [
	{ label: 'Home', href: '/' },
	{ label: 'About Us', href: '/about' },
	{ label: 'Properties', href: '/properties' },
	{ label: 'Services', href: '#services' },
];

const currentPath = Astro.url.pathname;
---

<div class="announcement">
	<p>
		<Icon name="heroicons:sparkles" width="16" height="16" />
		Discover Your Dream Property with Estatein
		<a href="#">Learn More</a>
	</p>
	<button type="button" class="announcement__close" data-dismiss="announcement" aria-label="Dismiss announcement">
		<Icon name="heroicons:x-mark" width="16" height="16" />
	</button>
</div>

<header class="site-header">
	<div class="site-header__inner">
		<EstateinLogo />
		<nav class="site-nav" aria-label="Primary">
			<ul>
				{
					navItems.map((item) => (
						<li>
							<a href={item.href} class={currentPath === item.href ? 'active' : ''}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a href="#contact" class="btn btn--outline">Contact Us</a>
	</div>
</header>

<style>
	.announcement {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 0.875rem clamp(1.5rem, 6vw, 5rem);
		background: var(--color-surface-raised);
		border-bottom: 1px solid var(--color-border);
		font-size: 0.85rem;
		font-weight: var(--font-weight-medium);
		color: var(--color-white);
		position: relative;
	}
	.announcement p {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}
	.announcement a {
		color: var(--color-white);
		text-decoration: underline;
	}
	.announcement__close {
		position: absolute;
		right: 2rem;
		width: 1.625rem;
		height: 1.625rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.1);
		color: var(--color-white);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.announcement__close:hover {
		background: rgba(255, 255, 255, 0.18);
	}

	.site-header {
		background: var(--color-surface-raised);
		border-bottom: 1px solid var(--color-border);
	}
	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: nowrap;
		gap: 1.5rem;
		padding: 0.875rem clamp(1.5rem, 6vw, 5rem);
		overflow-x: auto;
	}
	.site-header__inner > * {
		flex-shrink: 0;
	}
	.site-nav ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.site-nav a {
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: 0.5rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: var(--font-weight-medium);
	}
	.site-nav a:hover {
		color: var(--color-white);
	}
	.site-nav a.active {
		padding: 0.875rem 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-white);
	}
</style>

<script>
	import '../scripts/carousel.js';
</script>
