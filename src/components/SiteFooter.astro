---
import { Icon } from 'astro-icon/components';
import EstateinLogo from './EstateinLogo.astro';

const columns = [
	{ title: 'Home', links: ['Hero Section', 'Features', 'Properties', 'Testimonials', "FAQ's"] },
	{ title: 'About Us', links: ['Our Story', 'Our Works', 'How It Works', 'Our Team', 'Our Clients'] },
	{ title: 'Properties', links: ['Portfolio', 'Categories'] },
	{
		title: 'Services',
		links: [
			'Valuation Mastery',
			'Strategic Marketing',
			'Negotiation Wizardry',
			'Closing Success',
			'Property Management',
		],
	},
	{ title: 'Contact Us', links: ['Contact Form', 'Our Offices'] },
];

const socials = [
	{ name: 'Facebook', icon: 'simple-icons:facebook' },
	{ name: 'LinkedIn', icon: 'simple-icons:linkedin' },
	{ name: 'Twitter', icon: 'simple-icons:twitter' },
	{ name: 'YouTube', icon: 'simple-icons:youtube' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
	<div class="container site-footer__top">
		<div class="site-footer__brand">
			<EstateinLogo />
			<form class="newsletter">
				<input type="email" placeholder="Enter Your Email" required />
				<button type="submit" aria-label="Subscribe">
					<Icon name="heroicons:paper-airplane" width="18" height="18" />
				</button>
			</form>
		</div>
		{
			columns.map((col) => (
				<div class="site-footer__col">
					<h3>{col.title}</h3>
					<ul>
						{col.links.map((l) => (
							<li>
								<a href="#">{l}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<div class="container site-footer__bottom">
		<p>©{year} Estatein. All Rights Reserved</p>
		<a href="#">Terms &amp; Conditions</a>
		<div class="site-footer__social">
			{
				socials.map((s) => (
					<a href="#" aria-label={s.name}>
						<Icon name={s.icon} width="16" height="16" />
					</a>
				))
			}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding-block: 3rem 1.5rem;
		margin-top: 1rem;
	}
	.site-footer__top {
		display: grid;
		grid-template-columns: 1.5fr repeat(5, 1fr);
		gap: 2rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border);
	}
	.site-footer__brand {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.newsletter {
		display: flex;
		gap: 0.5rem;
	}
	.newsletter input {
		flex: 1;
		min-width: 0;
		padding: 0.65rem 0.9rem;
		border-radius: 0.5rem;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-white);
		font: inherit;
	}
	.newsletter input::placeholder {
		color: var(--color-text-muted);
	}
	.newsletter button {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.5rem;
		background: var(--color-purple-60);
		color: var(--color-white);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.site-footer__col h3 {
		font-size: 0.95rem;
		margin: 0 0 1rem;
	}
	.site-footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.site-footer__col a {
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}
	.site-footer__col a:hover {
		color: var(--color-white);
	}
	.site-footer__bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1.5rem;
		color: var(--color-text-muted);
		font-size: 0.85rem;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.site-footer__bottom p {
		margin: 0;
	}
	.site-footer__social {
		display: flex;
		gap: 0.75rem;
	}
	.site-footer__social a {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-white);
	}

	@media (max-width: 900px) {
		.site-footer__top {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 560px) {
		.site-footer__top {
			grid-template-columns: 1fr;
		}
		.site-footer__bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
