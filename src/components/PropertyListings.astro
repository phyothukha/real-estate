---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import villaImg from '../assets/home-page/Image.png';
import metropolitanImg from '../assets/home-page/Image (1).png';
import rusticImg from '../assets/home-page/Image (2).png';

const properties = [
	{
		category: 'Coastal Escapes - Where Waves Beckon',
		name: 'Seaside Serenity Villa',
		description: 'Wake up to the soothing melody of waves. This beachfront villa offers...',
		price: '$1,250,000',
		image: villaImg,
	},
	{
		category: 'Urban Oasis - Life in the Heart of the City',
		name: 'Metropolitan Haven',
		description: 'Immerse yourself in the energy of the city. This modern apartment in the heart...',
		price: '$650,000',
		image: metropolitanImg,
	},
	{
		category: 'Countryside Charm - Escape to Nature\'s Embrace',
		name: 'Rustic Retreat Cottage',
		description: 'Find tranquility in the countryside. This charming cottage is nestled amidst rolling hills...',
		price: '$350,000',
		image: rusticImg,
	},
];
---

<section class="section" id="categories">
	<div class="container">
		<div class="section__head">
			<div>
				<p class="eyebrow" aria-hidden="true">
					<Icon name="heroicons:sparkles" width="16" height="16" />
					<Icon name="heroicons:sparkles" width="10" height="10" />
					<span class="eyebrow__dot"></span>
				</p>
				<h2 class="section__title">Discover a World of Possibilities</h2>
				<p class="section__desc">
					Our portfolio of properties is as diverse as your dreams. Explore the following
					categories to find the perfect property that resonates with your vision of home
				</p>
			</div>
		</div>

		<div class="carousel-track" id="listings-track">
			{
				properties.map((p) => (
					<article class="listing-card">
						<Image
							src={p.image}
							alt={p.name}
							width={706}
							height={510}
							class="listing-card__image"
						/>
						<div class="listing-card__body">
							<span class="listing-card__category">{p.category}</span>
							<h3>{p.name}</h3>
							<p>
								{p.description} <a href="#">Read More</a>
							</p>
							<div class="listing-card__footer">
								<div>
									<span class="listing-card__price-label">Price</span>
									<strong>{p.price}</strong>
								</div>
								<a href="#" class="btn btn--solid">
									View Property Details
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="carousel-nav">
			<span>01 of 10</span>
			<div class="carousel-nav__buttons">
				<button type="button" data-carousel-prev="listings-track" aria-label="Previous property">
					<Icon name="heroicons:arrow-left" width="16" height="16" />
				</button>
				<button type="button" data-carousel-next="listings-track" aria-label="Next property">
					<Icon name="heroicons:arrow-right" width="16" height="16" />
				</button>
			</div>
		</div>
	</div>
</section>

<style>
	.listing-card {
		flex: 1 1 280px;
		min-width: 280px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.75rem;
		padding: 1rem;
		display: flex;
		flex-direction: column;
	}
	.listing-card__image {
		display: block;
		width: 100%;
		aspect-ratio: 353 / 255;
		object-fit: cover;
		border-radius: 0.625rem;
	}
	.listing-card__body {
		padding-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.listing-card__category {
		align-self: flex-start;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.35rem 0.8rem;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}
	.listing-card__body h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.listing-card__body p {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.listing-card__body p a {
		color: var(--color-white);
		text-decoration: underline;
	}
	.listing-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.5rem;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.listing-card__price-label {
		display: block;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}
	.listing-card__footer strong {
		font-size: 1.1rem;
	}
</style>

<script>
	import '../scripts/carousel.js';
</script>
